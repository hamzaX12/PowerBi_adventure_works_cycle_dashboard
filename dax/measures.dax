// =====================================================
// Adventure Works Cycle: DAX Measures
// =====================================================

// ---------- Base measures (Page 1) ----------
Total Sales = SUM(Sales[Sales Amount])
Total Profit = SUM(Sales[Profit])
Total Orders = COUNT(Sales[SalesOrderLineKey])
Total Cost = SUM(Sales[Total Product Cost])
Total Quantity = SUM(Sales[Order Quantity])

// ---------- KPIs (Page 2) ----------
Profit Margin % = DIVIDE([Total Profit], [Total Sales])

Avg Order Value =
DIVIDE([Total Sales], DISTINCTCOUNT(Sales[SalesOrderLineKey]))

Avg Unit Price = AVERAGE(Sales[Unit Price])

Total Customers = DISTINCTCOUNT(Sales[CustomerKey])

Sales per Customer = DIVIDE([Total Sales], [Total Customers])

Avg Discount % = AVERAGE(Sales[Unit Price Discount Pct])

Total Discount Amount =
SUMX(Sales, Sales[Extended Amount] - Sales[Sales Amount])

// ---------- Time intelligence ----------
Sales LY =
CALCULATE([Total Sales], SAMEPERIODLASTYEAR('Date'[Date]))

Sales YoY % =
DIVIDE([Total Sales] - [Sales LY], [Sales LY])

Profit LY =
CALCULATE([Total Profit], SAMEPERIODLASTYEAR('Date'[Date]))

Profit YoY % =
DIVIDE([Total Profit] - [Profit LY], [Profit LY])

Sales YTD =
TOTALYTD([Total Sales], 'Date'[Date], "6/30")

Sales Previous Month =
CALCULATE([Total Sales], DATEADD('Date'[Date], -1, MONTH))

Sales MoM % =
DIVIDE([Total Sales] - [Sales Previous Month], [Sales Previous Month])

Sales Running Total =
CALCULATE(
    [Total Sales],
    FILTER(ALL('Date'[Date]), 'Date'[Date] <= MAX('Date'[Date]))
)

// ---------- Customer analysis ----------
Customer Rank =
RANKX(ALL(Customer[Customer]), [Total Sales], , DESC, Dense)

Top 10 Customers Sales =
CALCULATE(
    [Total Sales],
    TOPN(10, ALL(Customer[Customer]), [Total Sales], DESC)
)

% Sales Top 10 Customers =
DIVIDE([Top 10 Customers Sales], CALCULATE([Total Sales], ALL(Customer)))

// ---------- Channel analysis ----------
Reseller Sales =
CALCULATE([Total Sales], SalesOrder[Channel] = "Reseller")

Internet Sales =
CALCULATE([Total Sales], SalesOrder[Channel] = "Internet")

Reseller % = DIVIDE([Reseller Sales], [Total Sales])

// ---------- Calculated column (Sales table) ----------
Discount Band =
SWITCH(
    TRUE(),
    Sales[Unit Price Discount Pct] = 0, "No Discount",
    Sales[Unit Price Discount Pct] <= 0.05, "1-5%",
    Sales[Unit Price Discount Pct] <= 0.15, "6-15%",
    "> 15%"
)